{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "anagem-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "anagem-frontend:build:production"
            },
            "development": {
              "buildTarget": "anagem-frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs",
            "port": 4300
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": [
              "src/app/**/*.ts"
            ],
            "coverageExclude": [
              "src/app/**/*.spec.ts",
              "src/app/app.config.server.ts",
              "src/app/app.routes.server.ts"
            ],
            "coverageReporters": [
              "text-summary",
              "html",
              "lcovonly"
            ],
            "setupFiles": [
              "src/testing/setup.ts"
            ],
            "coverageThresholds": {
              "statements": 78,
              "branches": 74,
              "functions": 64,
              "lines": 80
            }
          }
        }
      }
    }
  }
}
