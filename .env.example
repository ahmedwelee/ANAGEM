# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
DB_PASSWORD=change-me
# At least 32 random characters, e.g.:  openssl rand -base64 48
JWT_SECRET=

# Public address of the site, without a trailing slash. Used for canonical links, sitemap.xml and Open Graph.
PUBLIC_BASE_URL=http://localhost
# Host names the web server answers to, comma-separated (every public domain, plus localhost for local use).
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the API directly. The site itself is same-origin through the edge, so the default is fine.
# CORS_ALLOWED_ORIGINS=http://localhost

# First administrator, created only when the database has no users. Leave the password empty to get a random one in the backend log.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# true exposes Swagger UI on the backend port (loopback). Keep false in production.
SPRINGDOC_ENABLED=false
# Leave empty in production. 'dev' adds placeholder sample content and Swagger: development machines only.
SPRING_PROFILES_ACTIVE=

# Host ports (change them when 80 / 5432 / 8080 are already used on the machine)
HTTP_PORT=80
DB_PORT=5432
BACKEND_PORT=8080
